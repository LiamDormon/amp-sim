// window-view-switcher-sidebar.blp
// Scaffold using the new Adw.ViewSwitcherSidebar widget (libadwaita >= 1.9)
// AdwViewSwitcherSidebar is backed by an AdwViewStack; each AdwViewStackPage
// becomes a nav item with an icon, label, badge, and optional section grouping.
using Gtk 4.0;
using Adw 1;

template $AppWindow: Adw.ApplicationWindow {
  default-width: 960;
  default-height: 640;
  width-request: 360;
  height-request: 294;
  title: _("My App");
  // Collapse the split view and switch the sidebar into page mode
  // when the window becomes phone-width.
  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      split_view.collapsed: true;
      view_sidebar.mode: page;
    }
  }

  content: Adw.NavigationSplitView split_view {
    sidebar-width-fraction: 0.28;
    min-sidebar-width: 200;
    max-sidebar-width: 280;
    // ── SIDEBAR PANE ────────────────────────────────────────────────────
    sidebar: Adw.NavigationPage {
      title: _("Navigation");
      tag: "sidebar";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-end-title-buttons: false;

          [start]
          Gtk.MenuButton {
            icon-name: "open-menu-symbolic";
            primary: true;
            menu-model: primary_menu;
            tooltip-text: _("Main Menu");
          }
        }

        // AdwViewSwitcherSidebar is linked to an AdwViewStack.
        // Activating a sidebar row automatically switches the stack page.
        content: Gtk.Box {
          orientation: vertical;

          Adw.ViewSwitcherSidebar view_sidebar {
            stack: content_stack;
            mode: sidebar;
            hexpand: true;
            vexpand: true;
          }

          // Volume visualizer and playback toggle at the bottom
          Gtk.Separator {
            margin-top: 6;
            margin-bottom: 6;
          }

          Gtk.Box {
            orientation: vertical;
            spacing: 6;
            margin-start: 6;
            margin-end: 6;
            margin-bottom: 6;

            Gtk.Label {
              label: _("Playback");
              styles [ "caption-heading" ]
              xalign: 0;
            }

            // Volume level display (progress bar style)
            Gtk.ProgressBar volume_level {
              show-text: false;
              pulse-step: 0.1;
              hexpand: true;
              styles [ "osd" ]
            }

            // Playback toggle button
            Gtk.ToggleButton playback_toggle {
              label: _("Enable Audio");
              hexpand: true;
            }

            // Test signal toggle button
            Gtk.ToggleButton test_signal_toggle {
              label: _("Test Tone");
              hexpand: true;
            }
          }
        };
      };
    };

    // ── CONTENT PANE ────────────────────────────────────────────────────
    content: Adw.NavigationPage {
      title: _("Dashboard");
      tag: "content";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {}

        // The ViewStack lives here; the sidebar drives which page is visible.
        content: Adw.ViewStack content_stack {
          vexpand: true;
          hexpand: true;
          // Page 1 ── Dashboard  (opens group "Main")
          Adw.ViewStackPage {
            name: "dashboard";
            title: _("Dashboard");
            icon-name: "view-grid-symbolic";
            starts-section: true;
            section-title: _("Main");

            child: Adw.StatusPage {
              title: _("Dashboard");
              description: _("Dashboard");
              icon-name: "view-grid-symbolic";

              // Temporary buttons to toggle DSP test effects on/off.
              child: Gtk.Box {
                orientation: vertical;
                spacing: 12;
                halign: center;
                valign: center;

                Gtk.Label {
                  label: _("Test Effects");
                  styles [ "heading" ]
                }

                Gtk.ToggleButton overdrive_toggle {
                  label: _("Overdrive");
                }

                Gtk.ToggleButton delay_toggle {
                  label: _("Delay");
                }

                Gtk.ToggleButton amp_toggle {
                  label: _("Amp");
                }
              };
            };
          }

          // Page 2 ── Chain Editor
          Adw.ViewStackPage {
            name: "editor";
            title: _("Chain Editor");
            icon-name: "preferences-system-sharing-symbolic";

            child: Adw.StatusPage {
              title: _("Chain Editor");
              description: _("Not Implemented");
              icon-name: "preferences-system-sharing-symbolic";
            };
          }

          // Page 3 ── Presets
          Adw.ViewStackPage {
            name: "presets";
            title: _("Presets");
            icon-name: "folder-open-symbolic";

            child: Adw.StatusPage {
              title: _("Presets");
              description: _("No presets found.");
              icon-name: "folder-open-symbolic";
            };
          }

          // Page 4 ── Library
          Adw.ViewStackPage {
            name: "library";
            title: _("Library");
            icon-name: "accessories-dictionary-symbolic";

            child: Adw.StatusPage {
              title: _("Library");
              description: _("Not Implemented.");
              icon-name: "accessories-dictionary-symbolic";
            };
          }

          // Page 5 ── Settings
          Adw.ViewStackPage {
            name: "settings";
            title: _("Settings");
            icon-name: "applications-system-symbolic";
            starts-section: true;
            section-title: _("System");

            child: Gtk.Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 18;
              margin-bottom: 18;
              margin-start: 18;
              margin-end: 18;

              Gtk.Label {
                label: _("Audio Input");
                xalign: 0;
                styles [ "heading" ]
              }

              Gtk.Label {
                label: _("Choose which JACK source should feed the amp input. If nothing is selected, the first available source will be used.");
                wrap: true;
                xalign: 0;
              }

              Gtk.DropDown input_device_combo {
                hexpand: true;
              }
            };
          }
        };
      };
    };
  };
}

// ── MENUS ──────────────────────────────────────────────────────────────────
menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("_About My App");
      action: "app.about";
    }
  }
}
