// window-view-switcher-sidebar.blp
// Scaffold using the new Adw.ViewSwitcherSidebar widget (libadwaita >= 1.9)
// AdwViewSwitcherSidebar is backed by an AdwViewStack; each AdwViewStackPage
// becomes a nav item with an icon, label, badge, and optional section grouping.
using Gtk 4.0;
using Adw 1;

template $AppWindow: Adw.ApplicationWindow {
  default-width: 1400;
  default-height: 900;
  width-request: 360;
  height-request: 294;
  title: _("Ampsim");
  // Collapse the split view and switch the sidebar into page mode
  // when the window becomes phone-width.
  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      split_view.collapsed: true;
      view_sidebar.mode: page;
    }
  }

  // Below this width, the nav sidebar (up to 280px) plus the Chain Editor's
  // library sidebar (min 280px, alongside the canvas when chain_split_view
  // is uncollapsed) can together demand more than the window actually has,
  // which is what forced the window wider than available space ("AdwToastOverlay
  // exceeds AppWindow width") whenever the library was opened on a narrower
  // window. Collapsing chain_split_view makes the library an overlay drawer
  // instead of a docked pane, so it floats over the canvas rather than
  // adding to the width budget.
  Adw.Breakpoint {
    condition ("max-width: 900sp")

    setters {
      chain_split_view.collapsed: true;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationSplitView split_view {
    sidebar-width-fraction: 0.28;
    min-sidebar-width: 200;
    max-sidebar-width: 280;
    // ── SIDEBAR PANE ────────────────────────────────────────────────────
    sidebar: Adw.NavigationPage {
      title: _("Navigation");
      tag: "sidebar";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-end-title-buttons: false;

          [start]
          Gtk.MenuButton {
            icon-name: "open-menu-symbolic";
            primary: true;
            menu-model: primary_menu;
            tooltip-text: _("Main Menu");
            accessible-role: button;

            accessibility {
              label: _("Main Menu");
              description: _("Open preferences, keyboard shortcuts, and about");
            }
          }
        }

        // AdwViewSwitcherSidebar is linked to an AdwViewStack.
        // Activating a sidebar row automatically switches the stack page.
        content: Gtk.Box {
          orientation: vertical;

          Adw.ViewSwitcherSidebar view_sidebar {
            stack: content_stack;
            mode: sidebar;
            hexpand: true;
            vexpand: true;
          }

          // Volume visualizer and playback toggle at the bottom
          Gtk.Separator {
            margin-top: 6;
            margin-bottom: 6;
          }

          Gtk.Box {
            orientation: vertical;
            spacing: 6;
            margin-start: 6;
            margin-end: 6;
            margin-bottom: 6;

            Gtk.Label {
              label: _("Playback");
              styles [ "caption-heading" ]
              xalign: 0;
            }

            // Volume level display (progress bar style)
            Gtk.Box {
                orientation: horizontal;
                spacing: 6;

                Gtk.ProgressBar volume_level {
                  show-text: false;
                  pulse-step: 0.1;
                  hexpand: true;
                  valign: center;
                  styles [ "suggested-action" ]
                }

                // Playback toggle button
                Gtk.ToggleButton playback_toggle {
                  icon-name: "audio-headphones-symbolic";
                  hexpand: false;
                  valign: center;

                  // Hover Label (Tooltip)
                  tooltip-text: _("Audio Playback Toggle");

                  // Accessibility (GTK Accessible Interface)
                  accessible-role: toggle_button;

                  accessibility {
                    label: _("Audio Playback Toggle");
                    description: _("Toggles system audio output on or off");
                  }
                }
            }
          }

          // Built-in noise gate: a program feature (not a chain effect) for
          // taming hiss/hum/feedback on whatever input is currently selected.
          Gtk.Box {
            orientation: vertical;
            spacing: 6;
            margin-start: 6;
            margin-end: 6;
            margin-bottom: 6;

            Gtk.Label {
              label: _("Noise Gate");
              styles [ "caption-heading" ]
              xalign: 0;
            }

            Gtk.Box {
                orientation: horizontal;
                spacing: 6;

                Gtk.Box noise_gate_dial_container {
                  hexpand: true;
                  valign: center;
                }

                Gtk.ToggleButton noise_gate_toggle {
                  icon-name: "audio-volume-muted-symbolic";
                  hexpand: false;
                  valign: center;

                  tooltip-text: _("Noise Gate Toggle");
                  accessible-role: toggle_button;

                  accessibility {
                    label: _("Noise Gate Toggle");
                    description: _("Mutes the input below a threshold to tame hiss, hum or feedback");
                  }
                }
            }
          }
        };
      };
    };

    // ── CONTENT PANE ────────────────────────────────────────────────────
    content: Adw.NavigationPage {
      title: _("Dashboard");
      tag: "content";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          [title]
          Adw.WindowTitle preset_title {
            title: _("Untitled");
          }

          [end]
          Gtk.Box {
            orientation: horizontal;
            spacing: 6;

            Gtk.Button undo_button {
              icon-name: "edit-undo-symbolic";
              tooltip-text: _("Undo");
              sensitive: false;
              accessible-role: button;

              accessibility {
                label: _("Undo");
              }
            }

            Gtk.Button redo_button {
              icon-name: "edit-redo-symbolic";
              tooltip-text: _("Redo");
              sensitive: false;
              accessible-role: button;

              accessibility {
                label: _("Redo");
              }
            }

            Gtk.Button save_preset_button {
              icon-name: "document-save-symbolic";
              tooltip-text: _("Save Preset");
              accessible-role: button;

              accessibility {
                label: _("Save Preset");
              }
            }
          }
        }

        // The ViewStack lives here; the sidebar drives which page is visible.
        content: Adw.ViewStack content_stack {
          vexpand: true;
          hexpand: true;
          // AdwViewStack defaults both of these to true, meaning it sizes
          // itself to the max natural width/height across EVERY page, not
          // just whichever one is currently visible — so a single wide/tall
          // page (e.g. Chain Editor with the Library sidebar open, or a
          // content-heavy Settings page) forces the whole window, and every
          // other page along with it, to demand that much space even while
          // showing something much smaller (this was the actual cause behind
          // repeated "AdwToastOverlay exceeds AppWindow width/height"
          // warnings that kept reappearing on a different page after each
          // individual page's own content was fixed). Explicitly false so
          // each page is sized on its own terms.
          hhomogeneous: false;
          vhomogeneous: false;
          // Page 1 ── Dashboard  (opens group "Main")
          Adw.ViewStackPage {
            name: "dashboard";
            title: _("Dashboard");
            icon-name: "view-grid-symbolic";
            starts-section: true;
            section-title: _("Main");

            child: Gtk.Box dashboard_host {
              orientation: vertical;
              vexpand: true;
              hexpand: true;
            };
          }

          // Page 2 ── Chain Editor
          // The library browser docks alongside the canvas rather than living
          // on its own stack page: dragging a module onto the chain only works
          // if both are on screen at once, and the ViewStack shows one page at
          // a time. "+ Add Unit" reveals the sidebar.
          Adw.ViewStackPage {
            name: "editor";
            title: _("Chain Editor");
            icon-name: "preferences-system-sharing-symbolic";

            child: Adw.OverlaySplitView chain_split_view {
              sidebar-position: end;
              min-sidebar-width: 280;
              max-sidebar-width: 420;
              show-sidebar: false;
              vexpand: true;
              hexpand: true;

              content: Gtk.Box chain_editor_host {
                orientation: vertical;
                vexpand: true;
                hexpand: true;
              };

              sidebar: Gtk.Box library_host {
                orientation: vertical;
                vexpand: true;
                hexpand: true;
              };
            };
          }

          // Page 3 ── Presets
          Adw.ViewStackPage {
            name: "presets";
            title: _("Presets");
            icon-name: "folder-open-symbolic";

            child: Gtk.Box presets_host {
              orientation: vertical;
              vexpand: true;
              hexpand: true;
            };
          }

          // Page 4 ── Tuner
          Adw.ViewStackPage {
            name: "tuner";
            title: _("Tuner");
            icon-name: "power-profile-performance-symbolic";

            child: Gtk.Box tuner_host {
              orientation: vertical;
              vexpand: true;
              hexpand: true;
            };
          }

          // Page 4.5 ── Recording Booth
          Adw.ViewStackPage {
            name: "recording";
            title: _("Recording");
            icon-name: "audio-input-microphone-symbolic";

            child: Gtk.Box recording_booth_host {
              orientation: vertical;
              vexpand: true;
              hexpand: true;
            };
          }

          // Page 5 ── Settings
          Adw.ViewStackPage {
            name: "settings";
            title: _("Settings");
            icon-name: "applications-system-symbolic";
            starts-section: true;
            section-title: _("System");

            child: Gtk.Box settings_host {
              orientation: vertical;
              vexpand: true;
              hexpand: true;
            };
          }
        };
      };
    };
    };
  };
}

// ── MENUS ──────────────────────────────────────────────────────────────────
menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("_About My App");
      action: "app.about";
    }
  }
}
